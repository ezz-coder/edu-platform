# Bayan — Serv00 production environment template
# Copy to .env on the server and fill placeholders.
# NEVER commit real values of APP_KEY / DB_PASSWORD to Git.

APP_NAME="Bayan"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://__SERV00_USER__.serv00.net

APP_LOCALE=ar
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

# Serv00 provides free MySQL. Create the DB in the panel or via
# deploy/serv00/setup-remote.sh, then fill these in:
DB_CONNECTION=mysql
DB_HOST=__DB_HOST__
DB_PORT=3306
DB_DATABASE=__SERV00_USER___bayan
DB_USERNAME=__SERV00_USER___bayan
DB_PASSWORD=__CHANGE_ME__

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

MAIL_MAILER=log
MAIL_HOST=localhost
MAIL_PORT=25
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="no-reply@__SERV00_USER__.serv00.net"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"