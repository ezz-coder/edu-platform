# ============================================================
# Bayan Platform — PRODUCTION ENV TEMPLATE (server-side only)
# ============================================================
# Copy this file to the server as `/var/www/edu-platform/.env`
# then FILL IN the real values. NEVER commit this file with secrets.
# ============================================================

APP_NAME=Bayan
APP_ENV=production
APP_KEY=            # <- run: php artisan key:generate (server only)
APP_DEBUG=false
APP_URL=https://DOMAIN_NAME.duckdns.org
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

# --- MySQL production database ---
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=edu_platform
DB_USERNAME=edu_platform_app
DB_PASSWORD=CHANGE_ME_SECURE_PASSWORD

# --- Session (database driver; sessions table via migrate) ---
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync      # No queue jobs in this project -> sync is correct

CACHE_STORE=database

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# --- Mail: project does not send mail currently, keep log ---
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@DOMAIN_NAME.duckdns.org"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"